#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        cmb_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        cmb_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        cmb_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <18 20>;
        };

        wrap_parent {
            bindings = <&wrap_parent>;
            key-positions = <14 17>;
        };

        wrap_brace {
            bindings = <&wrap_brace>;
            key-positions = <26 29>;
        };

        wrap_bracket {
            bindings = <&wrap_bracket>;
            key-positions = <4 5>;
        };
    };

    macros {
        wrap_parent: wrap_parent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "WRAP_PARENT";
        };

        wrap_brace: wrap_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(RIGHT_BRACKET) &kp LS(NON_US_HASH) &kp LEFT>;
            label = "WRAP_BRACE";
        };

        wrap_bracket: wrap_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp NON_US_HASH &kp LEFT>;
            label = "WRAP_BRACKET";
        };

        kp_underscore: kp_underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER>;
            label = "KP_UNDERSCORE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp SEMI   &kp COMMA     &kp DOT       &kp P                 &kp Q                                                                    &kp Y        &kp G  &kp D  &kp M  &kp F
&kp A      &kp O         &kp E         &lt 5 I               &kp U                 &lt 6 UP_ARROW               &kp LEFT_BRACKET      &kp B        &kp N  &kp T  &kp R  &kp S
&kp Z      &kp X         &kp C         &kp V                 &kp W                 &kp DOWN_ARROW               &kp LS(SINGLE_QUOTE)  &kp H        &kp J  &kp K  &kp L  &kp MINUS
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mt LCTRL LANGUAGE_2  &mt LEFT_SHIFT SPACE  &mt LEFT_ALT LANGUAGE_1      &lt 1 BACKSPACE       &lt 2 ENTER                       &lt 5 SLASH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &kp KP_LEFT_PARENTHESIS   &trans                              &kp KP_SUBTRACT  &kp N7  &kp N8  &kp N9  &kp KP_PLUS
&trans  &trans  &trans  &kp KP_RIGHT_PARENTHESIS  &trans  &trans      &kp KP_NUMLOCK  &kp KP_DIVIDE    &kp N4  &kp N5  &kp N6  &kp KP_ASTERISK
&trans  &trans  &trans  &trans                    &trans  &trans      &trans          &kp N0           &kp N1  &kp N2  &kp N3  &kp KP_EQUAL
&trans  &trans  &trans  &trans                    &trans  &trans      &trans          &trans                                   &none
            >;
        };

        NUM {
            bindings = <
&kp LS(EXCL)  &kp LEFT_BRACKET  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)                          &kp EQUAL  &kp LS(NUMBER_6)  &kp LS(SINGLE_QUOTE)  &kp LS(N8)  &kp LS(N9)
&kp N1        &kp N2            &kp N3         &kp N4        &kp N5         &none         &none     &kp N6     &kp N7            &kp N8                &kp N9      &kp N0
&kp F1        &kp F2            &kp F3         &kp F4        &kp F5         &none         &trans    &kp F6     &kp F7            &kp F8                &kp F9      &kp F10
&kp F11       &kp F12           &trans         &kp LCTRL     &kp LSHFT      &kp LALT      &kp BSPC  &kp ENTER                                                      &none
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&kp SINGLE_QUOTE      &kp LS(QMARK)     &kp LS(EXCL)  &trans    &trans                         &kp PG_UP  &kp BSPC  &kp ESC  &kp DEL    &kp LS(INTERNATIONAL_3)
&kp LALT              &kp LCTRL         &kp LSHFT     &trans    &trans   &trans       &trans   &kp LEFT   &kp DOWN  &kp UP   &kp RIGHT  &kp LS(EQUAL)
&kp LS(LEFT_BRACKET)  &kp LS(NUMBER_2)  &kp LS(N7)    &trans    &trans   &trans       &trans   &kp PG_DN  &kp HOME  &kp F2   &kp END    &kp LS(INTERNATIONAL_1)
&none                 &none             &none         &kp HOME  &kp TAB  &kp END      &kp ESC  &trans                                   &kp NON_US_BSLH
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
